        "import os\n",
        "from datetime import datetime\n",
        "import random\n",
        "def get_readings_by_location(readings_list, target_location):\n",
        "    return [reading for reading in readings_list\n",
        "            if reading[\"LOCATION\"] == target_location]\n",
        "\n",
        "LOCATIONS = [\"Hyderabad\", \"Delhi\", \"Mumbai\", \"Chennai\", \"Bengaluru\"]\n",
        "DEVICE_TYPES = [\"Temperature\", \"Humidity\", \"Pressure\", \"Motion\"]\n",
        "\n",
        "target = input(\"Enter target location: \")\n",
        "\n",
        "ar = []\n",
        "\n",
        "for _ in range(100):\n",
        "    now = datetime.now()\n",
        "\n",
        "    reading = {\n",
        "        \"TIME\": now.strftime(\"%y-%m-%d %H:%M:%S\"),\n",
        "        \"DEVICE_ID\": \"DEV\" + str(random.randint(1, 100)),\n",
        "        \"VALUE\": round(random.random(), 2),\n",
        "        \"LOCATION\": random.choice(LOCATIONS),\n",
        "        \"DEVICE_TYPE\": random.choice(DEVICE_TYPES)\n",
        "    }\n",
        "\n",
        "    ar.append(reading)\n",
        "print()\n",
        "\n",
        "result = get_readings_by_location(ar, target)\n",
        "\n",
        "print(result)\n",
        "\n"
